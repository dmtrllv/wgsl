{
	"name": "wgsl-client",
	"displayName": "wgsl-client",
	"description": "",
	"version": "0.0.1",
	"publisher": "dmtrllv",
	"engines": {
		"vscode": "^1.136.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onLanguage:wgsl"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "wgsl-client.helloWorld",
				"title": "Hello World"
			}
		],
		"languages": [
			{
				"id": "wgsl",
				"aliases": [
					"WGSL",
					"wgsl"
				],
				"extensions": [
					".wgsl"
				]
			}
		],
		"grammars": [
			{
				"language": "wgsl",
				"scopeName": "source.wgsl",
				"path": "./syntaxes/wgsl.tmLanguage.json"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc",
		"watch": "tsc -w",
		"build-server-win": "xcopy \"../language-server/dist\" \"./out/language-server\" /E /I",
		"install-ext-win": "npm run build-server-win && mklink /D \"%USERPROFILE%\\.vscode\\extensions\\dmtrllv.wgsl-client-0.0.1\" \"apps\\vscode-client\""
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/vscode": "^1.136.0",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	},
	"dependencies": {
		"vscode-languageclient": "^10.1.1"
	}
}
